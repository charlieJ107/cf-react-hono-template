// PLACEHOLDER — Cloudflare Workers is the optional, secondary deployment target and is not
// wired up yet: `main` below does not exist, there is no `wrangler` dependency and no npm
// script uses this file. See docs/deploy/cloudflare.md for the full checklist.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "cf-react-hono-template",
	// To implement: fetch (Hono app) + queue (background jobs) handlers. See src/runtime/cloudflare/README.md.
	"main": "./src/runtime/cloudflare/worker.ts",
	// nodejs_compat is on by default for compatibility_date >= 2026-08-04 (needed by pg, better-auth).
	"compatibility_date": "2026-10-15",
	"observability": {
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true }
	},
	"upload_source_maps": true,

	// The SPA built by the frontend workspace (`npm run build`) is uploaded with the Worker.
	// Asset requests never invoke the Worker, except /api/* which always goes to Hono.
	"assets": {
		"directory": "../frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	// --- Database: pick ONE -------------------------------------------------------------
	// (a) Postgres through Hyperdrive (same schema and migrations as Node):
	// "hyperdrive": [
	// 	{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }
	// ],
	//
	// (b) D1 (SQLite; uses src/infra/d1/kysely-d1.ts; needs SQLite-dialect migrations):
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "cf-react-hono-template",
	// 		"database_id": "<id from `npx wrangler d1 create cf-react-hono-template`>",
	// 		"migrations_dir": "db/d1"
	// 	}
	// ],

	// --- Key-value store (KV port; in-memory implementation on Node) ----------------------
	// "kv_namespaces": [
	// 	{ "binding": "KV", "id": "<id from `npx wrangler kv namespace create KV`>" }
	// ],

	// --- Object storage (object-storage port; S3 on Node) ---------------------------------
	// "r2_buckets": [
	// 	{ "binding": "BUCKET", "bucket_name": "cf-react-hono-template" }
	// ],

	// --- Background jobs (dispatcher port: "continue job X" messages) ---------------------
	// "queues": {
	// 	"producers": [{ "binding": "JOBS", "queue": "cf-react-hono-template-jobs" }],
	// 	"consumers": [{ "queue": "cf-react-hono-template-jobs", "max_batch_size": 1 }]
	// },

	// Non-secret configuration. Secrets (BETTER_AUTH_SECRET, OIDC_CLIENT_SECRET, ...) go in
	// .dev.vars locally and `npx wrangler secret put <NAME>` in production.
	"vars": {
		"BETTER_AUTH_URL": "https://<your-worker-domain>"
	}
}
