# Copy to .env (repo root) and fill in. Every tool reads this one file; variables already set
# in the environment (CI, shell, Docker) take precedence over it.

# Postgres used by the app, `kysely migrate` and `auth generate`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# better-auth. Generate a secret with: npx auth secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Origin the browser uses. In dev that is the Vite server (it proxies /api to the backend).
BETTER_AUTH_URL=http://localhost:5173
# Versioned secrets for rotation, newest first: "<version>:<secret>,...".
# The first entry encrypts; older entries are decrypt-only. When set,
# BETTER_AUTH_SECRET is only used to decrypt legacy (pre-envelope) payloads.
# BETTER_AUTH_SECRETS=1:replace-with-a-long-random-secret

# OIDC sign-in. Sign-in is disabled unless all three are set.
# Redirect URI to register at the provider: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_DISCOVERY_URL=https://auth.zhuoling.space/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# PORT=3000

# Directory of the built SPA to serve from the same origin (set in Docker; unset in dev,
# where the Vite dev server proxies /api to this process).
# STATIC_ROOT=../frontend/dist
