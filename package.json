    "clsx": "^2.1.1",
    "hono": "^4.12.19",
    "kysely": "^0.28.17",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "shadcn": "^4.7.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
