{
  "name": "cf-react-hono-template",
  "version": "2.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "start": "npm run start -w backend",
    "lint": "oxlint",
    "db:migrate": "npm exec -w backend -- kysely migrate:latest",
    "test": "vitest run"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vitest": "^5.0.5"
  }
}
