{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-react-hono-template",
	"main": "./src/server/index.ts",
	"compatibility_date": "2026-03-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf-react-hono-template",
			"database_id": "e04a7ec3-12eb-4cce-8f06-4d6823ceb1c1"
		}
	]
}